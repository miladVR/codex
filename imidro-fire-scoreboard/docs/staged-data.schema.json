{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/miladVR/codex/imidro-staged-v7",
  "title": "IMIDRO v7 canonical competition snapshot",
  "type": "object",
  "required": [
    "version",
    "teams",
    "athletes",
    "roundScores",
    "settings",
    "combinedStartOrder",
    "combinedSlots",
    "participantProfiles",
    "results",
    "disciplines",
    "disciplineCatalog"
  ],
  "properties": {
    "version": {
      "const": 7
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Team"
      }
    },
    "athletes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Athlete"
      }
    },
    "roundScores": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RoundScore"
      }
    },
    "settings": {
      "$ref": "#/$defs/EventConfig"
    },
    "combinedStartOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "combinedSlots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CombinedSlot"
      }
    },
    "participantProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ParticipantProfile"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Result"
      }
    },
    "disciplineCatalog": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/Discipline"
      }
    },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/Discipline"
      }
    }
  },
  "$defs": {
    "Team": {
      "type": "object",
      "required": [
        "id",
        "name",
        "code",
        "organization"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "code": {
          "type": "string"
        },
        "organization": {
          "type": "string",
          "maxLength": 150
        }
      }
    },
    "Athlete": {
      "type": "object",
      "required": [
        "id",
        "teamId",
        "round",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "teamId": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "enum": [
            1,
            2
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "RoundScore": {
      "type": "object",
      "required": [
        "id",
        "athleteId",
        "teamId",
        "round",
        "rawMs",
        "penaltyMs",
        "lane",
        "heat",
        "athleteNumber",
        "drawOrder",
        "judge",
        "note",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "athleteId": {
          "type": "integer",
          "minimum": 1
        },
        "teamId": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "enum": [
            1,
            2
          ]
        },
        "rawMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5999990
        },
        "penaltyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "lane": {
          "enum": [
            1,
            2
          ]
        },
        "heat": {
          "type": "integer",
          "minimum": 1
        },
        "athleteNumber": {
          "type": "integer",
          "minimum": 1
        },
        "drawOrder": {
          "type": "integer",
          "minimum": 1
        },
        "judge": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventConfig": {
      "type": "object",
      "required": [
        "competitionName",
        "venue",
        "eventDate",
        "displayMessage",
        "competitionLogo",
        "sponsorLogos"
      ],
      "properties": {
        "competitionName": {
          "type": "string",
          "maxLength": 180
        },
        "venue": {
          "type": "string",
          "maxLength": 180
        },
        "eventDate": {
          "type": "string",
          "maxLength": 80
        },
        "displayMessage": {
          "type": "string",
          "maxLength": 220
        },
        "competitionLogo": {
          "type": "string"
        },
        "sponsorLogos": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "displayMode": {
          "enum": [
            "standings",
            "item",
            "individual",
            "draw"
          ]
        },
        "audioEnabled": {
          "type": "boolean"
        },
        "audioVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "autoRotate": {
          "type": "boolean"
        },
        "backgroundMode": {
          "enum": [
            "solid",
            "gradient"
          ],
          "default": "solid"
        },
        "backgroundStart": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#ffffff"
        },
        "backgroundEnd": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#fff7e6"
        },
        "backgroundAngle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360,
          "default": 135
        },
        "displayTextSize": {
          "enum": [
            "standard",
            "large"
          ],
          "default": "large"
        },
        "appearanceVersion": {
          "const": 2
        },
        "fontFamily": {
          "enum": [
            "zar",
            "tahoma",
            "arial",
            "custom"
          ],
          "default": "zar"
        },
        "customFont": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9 _\\-\\u0600-\\u06ff]*$"
        },
        "adminFontSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 24,
          "default": 18
        },
        "hallFontMax": {
          "type": "integer",
          "minimum": 18,
          "maximum": 44,
          "default": 34
        },
        "fontWeight": {
          "enum": [
            400,
            700
          ],
          "default": 400
        },
        "numberFont": {
          "enum": [
            "monospace",
            "same"
          ],
          "default": "monospace"
        },
        "buttonSize": {
          "enum": [
            "compact",
            "comfortable"
          ],
          "default": "compact"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#000000"
        },
        "mutedColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#000000"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#000000"
        },
        "surfaceColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#fff7e6"
        },
        "inputColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#fffdf7"
        },
        "borderColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#d7cab4"
        },
        "buttonColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#f1dfbe"
        },
        "buttonTextColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#000000"
        },
        "successColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#d4edda"
        },
        "dangerColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#f8d7da"
        },
        "neutralColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#fffaf0"
        },
        "rowOddColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#fff7e6"
        },
        "rowEvenColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#e6f0fa"
        },
        "secondaryLogo": {
          "type": "string"
        }
      }
    },
    "CombinedSlot": {
      "type": "object",
      "required": [
        "teamId",
        "round",
        "drawOrder",
        "athleteNumber",
        "heat",
        "lane",
        "supplemental"
      ],
      "properties": {
        "teamId": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "enum": [
            1,
            2
          ]
        },
        "drawOrder": {
          "type": "integer",
          "minimum": 1
        },
        "athleteNumber": {
          "type": "integer",
          "minimum": 1
        },
        "heat": {
          "type": "integer",
          "minimum": 1
        },
        "lane": {
          "enum": [
            1,
            2
          ]
        },
        "supplemental": {
          "type": "boolean"
        }
      }
    },
    "ParticipantProfile": {
      "type": "object",
      "required": [
        "id",
        "teamId",
        "disciplineId",
        "slot",
        "name",
        "photo"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "teamId": {
          "type": "integer",
          "minimum": 1
        },
        "disciplineId": {
          "enum": [
            "scientific",
            "combined",
            "water",
            "rescue_skill",
            "height",
            "emergency_scientific",
            "emergency_operational"
          ]
        },
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "photo": {
          "type": "string",
          "description": "Empty or PNG/JPEG/WebP data URI; decoded payload <=256KiB"
        }
      }
    },
    "ScientificEntry": {
      "type": "object",
      "required": [
        "slot",
        "score",
        "durationMs"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5999990
        }
      }
    },
    "Result": {
      "type": "object",
      "required": [
        "id",
        "teamId",
        "disciplineId",
        "status"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "teamId": {
          "type": "integer",
          "minimum": 1
        },
        "disciplineId": {
          "enum": [
            "scientific",
            "combined",
            "water",
            "rescue_skill",
            "height",
            "emergency_scientific",
            "emergency_operational"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        },
        "completionStatus": {
          "enum": [
            "Pending",
            "Partial",
            "Completed"
          ]
        },
        "scientificEntries": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/ScientificEntry"
          }
        },
        "scientificScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 20000
        },
        "scientificSubtotal": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "legacyScientific": {
          "type": "boolean"
        }
      }
    },
    "Discipline": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mode",
        "position",
        "enabled",
        "configured",
        "participantCount",
        "maxScore",
        "aggregation"
      ],
      "properties": {
        "id": {
          "enum": [
            "scientific",
            "combined",
            "water",
            "rescue_skill",
            "height",
            "emergency_scientific",
            "emergency_operational"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "mode": {
          "enum": [
            "score",
            "time",
            "pair_time"
          ]
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "enabled": {
          "type": "boolean"
        },
        "configured": {
          "type": "boolean"
        },
        "participantCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxScore": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "aggregation": {
          "enum": [
            "sum",
            "average"
          ]
        }
      }
    }
  }
}
