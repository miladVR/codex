{
  "name": "imidro-fire-scoreboard",
  "version": "1.4.1",
  "description": "Offline Windows scoring system for IMIDRO firefighters competitions",
  "main": "main.cjs",
  "author": "Milad Rabiei",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:smoke": "electron scripts/smoke.cjs",
    "dist:win": "electron-builder --win nsis portable",
    "guide:build": "node scripts/build-guide.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ir.imidro.fire.scoreboard",
    "productName": "IMIDRO Fire Scoreboard",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "display-controller.cjs",
      "preload.cjs",
      "store.cjs",
      "scoring.cjs",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "report.cjs",
      "docs/IMIDRO-Fire-Scoreboard-User-Guide-FA.pdf",
      "combined.cjs",
      "branding.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "IMIDRO-Fire-Scoreboard-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "IMIDRO-Fire-Scoreboard-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "\u0633\u0627\u0645\u0627\u0646\u0647 \u0627\u0645\u062a\u06cc\u0627\u0632\u062f\u0647\u06cc \u0622\u062a\u0634\u200c\u0646\u0634\u0627\u0646\u0627\u0646 \u0627\u06cc\u0645\u06cc\u062f\u0631\u0648"
    }
  }
}
